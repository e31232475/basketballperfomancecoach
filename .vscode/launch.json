{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Android Emulator Local API",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define=API_BASE_URL=http://10.0.2.2:8000/api"
      ]
    },
    {
      "name": "Flutter Web Chrome Fixed Port",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--web-port",
        "62355"
      ]
    }
  ]
}
